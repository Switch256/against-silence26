# Copy to .env and fill in your own values
DATABASE_URL=postgresql://aegis:change-me@localhost:5432/aegis_medlink
TEST_DATABASE_URL=postgresql://aegis:change-me@localhost:5432/aegis_medlink_test
ASTRONAUT_ID=crew-01
# Simulated signal delay Earth <-> spacecraft, and minutes until the next link window
ONE_WAY_DELAY_MIN=14
NEXT_WINDOW_MIN=12
# MEDLINK transport: "local" (in-process) or "dtn" (real BPv7 via backend/dtn/docker-compose.yml)
MEDLINK_TRANSPORT=local
DTN_SPACECRAFT_URL=http://127.0.0.1:3020
DTN_EARTH_URL=http://127.0.0.1:3021
DTN_NETWORK=aegis-spacelink
DTN_EARTH_CONTAINER=aegis-dtn-earth
DTN_EARTH_IP=172.31.0.20
